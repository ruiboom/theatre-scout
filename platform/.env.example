# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/listings

# --- Internal API (consumed by every surface) ---
# In dev, the Next.js app exposes the API at /api/v1
API_BASE_URL=http://localhost:3000/api/v1

# --- MCP server (Cloudflare Workers) ---
# Where the worker fetches data from. In prod, point at your deployed website.
MCP_API_BASE_URL=http://localhost:3000/api/v1
MCP_SHARED_SECRET=replace-me-in-prod

# --- Scrapers ---
# Used by Python scrapers when posting normalized data back to the API
SCRAPER_API_BASE_URL=http://localhost:3000/api/v1
SCRAPER_API_KEY=dev-only-replace-me

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- (Optional) LLM for recommend_shows ---
# If unset, the recommender falls back to tag/embedding similarity.
ANTHROPIC_API_KEY=

# --- Admin (gates /admin pages and the refresh-trigger button) ---
# Single password for the dashboard at /admin. Hashed (sha256) into a cookie
# on login. Rotate to invalidate sessions.
ADMIN_PASSWORD=

# Fine-grained PAT with `Actions: read & write` on the repo, used by the
# admin "Refresh data" button to dispatch the daily-scrape workflow.
GITHUB_TOKEN=
GITHUB_REPO=ruiboom/theatre-scout
GITHUB_WORKFLOW=scrape.yml
